<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة المناهج التعليمية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        :focus-visible { outline: 3px solid #4338ca; outline-offset: 2px; }
        .fade-in { animation: fadeIn .25s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px);} to { opacity: 1; transform: translateY(0);} }
        @media (prefers-reduced-motion: reduce) {
            .fade-in { animation: none; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <header class="bg-indigo-700 text-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <h1 id="nav-title" class="text-2xl font-bold">🎓 منصة المناهج التعليمية</h1>

            <div class="flex items-center gap-2">
                <label for="lang-select" class="text-sm sr-only" id="lang-select-label">اللغة</label>
                <span aria-hidden="true" class="text-sm">🌐</span>
                <select id="lang-select" onchange="changeLanguage(this.value)" class="bg-indigo-800 text-white text-sm rounded-lg p-2 border border-indigo-500 focus:outline-none">
                    <option value="ar" selected>العربية</option>
                    <option value="en">English</option>
                    <option value="fr">Français</option>
                </select>
            </div>
        </div>
    </header>

    <main class="container mx-auto px-4 py-8 flex-grow">

        <!-- Step 1: Country -->
        <section id="view-country" class="mb-10 text-center">
            <h2 id="curriculum-title" class="text-2xl md:text-3xl font-bold mb-3 text-slate-900">اختر المنهاج الدراسي</h2>
            <p id="curriculum-desc" class="text-slate-600 mb-6">حدد الدولة لعرض الصفوف والمواد المعتمدة</p>

            <div id="countries-container" class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto" role="group" aria-labelledby="curriculum-title"></div>
        </section>

        <hr class="border-slate-200 my-8">

        <!-- Step 2: Grade -->
        <section id="view-grades" class="mb-10">
            <h3 id="grade-title" class="text-xl font-bold mb-6 text-slate-800 text-center">اختر الصف الدراسي</h3>
            <div id="grades-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 max-w-5xl mx-auto" role="group" aria-labelledby="grade-title"></div>
        </section>

        <!-- Step 2.5: Academic field (فرع) — grades 11-12 only -->
        <section id="view-field" class="mb-10 hidden fade-in">
            <div class="flex items-center justify-between max-w-3xl mx-auto mb-6">
                <button id="back-btn-field" onclick="showGrades()" class="text-indigo-700 font-bold hover:underline flex items-center gap-1">
                    <span id="back-label-field">→ رجوع للصفوف</span>
                </button>
                <h3 id="field-title" class="text-xl font-bold text-slate-800"></h3>
                <span class="w-16" aria-hidden="true"></span>
            </div>
            <div id="fields-container" class="grid grid-cols-2 gap-4 max-w-3xl mx-auto" role="group" aria-labelledby="field-title"></div>
        </section>

        <!-- Step 3: Subjects -->
        <section id="view-subjects" class="mb-10 hidden fade-in">
            <div class="flex items-center justify-between max-w-5xl mx-auto mb-6">
                <button id="back-btn" onclick="backFromSubjects()" class="text-indigo-700 font-bold hover:underline flex items-center gap-1">
                    <span id="back-label">→ رجوع للصفوف</span>
                </button>
                <h3 id="subjects-title" class="text-xl font-bold text-slate-800"></h3>
                <span class="w-16" aria-hidden="true"></span>
            </div>
            <div id="subjects-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 max-w-5xl mx-auto" role="group" aria-labelledby="subjects-title"></div>
        </section>

        <!-- Step 4: Foundation subjects (تأسيس) -->
        <section id="view-foundation" class="mb-10 hidden fade-in">
            <div class="flex items-center justify-between max-w-5xl mx-auto mb-6">
                <button id="back-btn-2" onclick="showSubjects()" class="text-indigo-700 font-bold hover:underline flex items-center gap-1">
                    <span id="back-label-2">→ رجوع للمواد</span>
                </button>
                <h3 id="foundation-title" class="text-xl font-bold text-slate-800"></h3>
                <span class="w-16" aria-hidden="true"></span>
            </div>
            <div id="foundation-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 max-w-5xl mx-auto" role="group" aria-labelledby="foundation-title"></div>
        </section>

    </main>

    <footer class="bg-slate-900 text-slate-400 py-6 text-center text-sm">
        <p id="footer-text">جميع الحقوق محفوظة © 2026 - منصة المناهج التعليمية الشاملة</p>
    </footer>

    <script>
        // ---------- Data ----------
        // Subjects are defined per country so each curriculum can differ.
        // A "default" set covers grades that don't have a specific override.
        const subjectSets = {
            core: ["arabic", "math", "science", "english", "socialStudies", "islamic", "arts", "pe"],
            senior: ["arabic", "math", "physics", "chemistry", "biology", "english", "socialStudies", "islamic"]
        };

        const countries = {
            jo: { emoji: "🇯🇴", subjects: subjectSets },
            sy: { emoji: "🇸🇾", subjects: subjectSets },
            ps: { emoji: "🇵🇸", subjects: subjectSets },
            all: { emoji: "🌐", subjects: subjectSets }
        };

        const subjectMeta = {
            arabic:        { icon: "📖", ar: "اللغة العربية",      en: "Arabic",           fr: "Arabe" },
            math:          { icon: "🔢", ar: "الرياضيات",          en: "Mathematics",      fr: "Mathématiques" },
            science:       { icon: "🔬", ar: "العلوم",             en: "Science",          fr: "Sciences" },
            physics:       { icon: "⚛️", ar: "الفيزياء",           en: "Physics",          fr: "Physique" },
            chemistry:     { icon: "🧪", ar: "الكيمياء",           en: "Chemistry",        fr: "Chimie" },
            biology:       { icon: "🧬", ar: "الأحياء",            en: "Biology",          fr: "Biologie" },
            english:       { icon: "🔤", ar: "اللغة الإنجليزية",   en: "English",          fr: "Anglais" },
            socialStudies: { icon: "🌍", ar: "الدراسات الاجتماعية", en: "Social Studies",  fr: "Études sociales" },
            islamic:       { icon: "🕌", ar: "التربية الإسلامية",  en: "Islamic Education",fr: "Éducation islamique" },
            arts:          { icon: "🎨", ar: "التربية الفنية",     en: "Arts",             fr: "Arts" },
            pe:            { icon: "⚽", ar: "التربية الرياضية",   en: "Physical Education", fr: "Éducation physique" },
            foundationArabic:  { icon: "📖", ar: "اللغة العربية", en: "Arabic", fr: "Arabe", teacher: "محمد محروس" },
            foundationIslamic: { icon: "🕌", ar: "التربية الإسلامية", en: "Islamic Education", fr: "Éducation Islamique", teacher: "أحمد أبو لعسل" },
            foundationHistory: { icon: "🏺", ar: "تاريخ الأردن", en: "Jordan History", fr: "Histoire de Jordanie", teacher: "محمود بني عطا" },
            foundationMath:    { icon: "🔢", ar: "الرياضيات", en: "Mathematics", fr: "Mathématiques", teacher: "فخري جرار / محمد نجار" },
            foundation: { icon: "🎯", ar: "تأسيس المواد الوزارية", en: "Ministerial Subjects Foundation", fr: "Fondation Matières Ministérielles" }
        };

        const translations = {
            ar: {
                dir: "rtl",
                navTitle: "🎓 منصة المناهج التعليمية",
                curriculumTitle: "اختر المنهاج الدراسي",
                curriculumDesc: "حدد الدولة لعرض الصفوف والمواد المعتمدة",
                countryNames: { jo: "المنهاج الأردني", sy: "المنهاج السوري", ps: "المنهاج الفلسطيني", all: "باقي المناهج" },
                gradeTitle: "اختر الصف الدراسي (١ - ١٢)",
                viewSubjects: "عرض المواد ←",
                backLabel: "→ رجوع للصفوف",
                backLabel2: "→ رجوع للمواد",
                foundationTitle: "تأسيس المواد الوزارية",
                fieldTitle: "اختر الفرع الأكاديمي",
                fieldAcademic: "أكاديمي",
                fieldBitc: "BITC",
                comingSoon: "قريباً",
                subjectsTitleFor: (grade) => `مواد ${grade}`,
                footer: "جميع الحقوق محفوظة © 2026 - منصة المناهج التعليمية الشاملة",
                grades: ["الصف الأول", "الصف الثاني", "الصف الثالث", "الصف الرابع", "الصف الخامس", "الصف السادس", "الصف السابع", "الصف الثامن", "الصف التاسع", "الصف العاشر", "الحادي عشر", "الثاني عشر"]
            },
            en: {
                dir: "ltr",
                navTitle: "🎓 Educational Curricula Platform",
                curriculumTitle: "Select Curriculum",
                curriculumDesc: "Choose a country to view available grades and subjects",
                countryNames: { jo: "Jordanian Curriculum", sy: "Syrian Curriculum", ps: "Palestinian Curriculum", all: "Other Curricula" },
                gradeTitle: "Select Grade Level (1 - 12)",
                viewSubjects: "View Subjects →",
                backLabel: "← Back to grades",
                backLabel2: "← Back to subjects",
                foundationTitle: "Ministerial Subjects Foundation",
                fieldTitle: "Select Academic Field",
                fieldAcademic: "Academic",
                fieldBitc: "BITC",
                comingSoon: "Coming soon",
                subjectsTitleFor: (grade) => `${grade} subjects`,
                footer: "All rights reserved © 2026 - Educational Curricula Platform",
                grades: ["Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Grade 6", "Grade 7", "Grade 8", "Grade 9", "Grade 10", "Grade 11", "Grade 12"]
            },
            fr: {
                dir: "ltr",
                navTitle: "🎓 Plateforme des Programmes Éducatifs",
                curriculumTitle: "Sélectionnez le Programme",
                curriculumDesc: "Choisissez un pays pour voir les classes et matières",
                countryNames: { jo: "Programme Jordanien", sy: "Programme Syrien", ps: "Programme Palestinien", all: "Autres Programmes" },
                gradeTitle: "Sélectionnez le Niveau (1 - 12)",
                viewSubjects: "Voir les matières →",
                backLabel: "← Retour aux classes",
                backLabel2: "← Retour aux matières",
                foundationTitle: "Fondation Matières Ministérielles",
                fieldTitle: "Sélectionnez la filière",
                fieldAcademic: "Académique",
                fieldBitc: "BITC",
                comingSoon: "Bientôt disponible",
                subjectsTitleFor: (grade) => `Matières — ${grade}`,
                footer: "Tous droits réservés © 2026 - Plateforme Éducative",
                grades: ["1ère Année", "2ème Année", "3ème Année", "4ème Année", "5ème Année", "6ème Année", "7ème Année", "8ème Année", "9ème Année", "10ème Année", "11ème Année", "12ème Année"]
            }
        };

        // ---------- State ----------
        let currentLang = 'ar';
        let selectedCountry = 'jo';
        let selectedGradeIndex = null;
        let selectedField = null;

        // ---------- Rendering ----------
        function t() { return translations[currentLang]; }

        function changeLanguage(lang) {
            currentLang = lang;
            const tr = t();

            document.documentElement.dir = tr.dir;
            document.documentElement.lang = lang;

            document.getElementById('nav-title').innerText = tr.navTitle;
            document.getElementById('curriculum-title').innerText = tr.curriculumTitle;
            document.getElementById('curriculum-desc').innerText = tr.curriculumDesc;
            document.getElementById('grade-title').innerText = tr.gradeTitle;
            document.getElementById('back-label').innerText = tr.backLabel;
            document.getElementById('back-label-2').innerText = tr.backLabel2;
            document.getElementById('foundation-title').innerText = tr.foundationTitle;
            document.getElementById('back-label-field').innerText = tr.backLabel;
            document.getElementById('field-title').innerText = tr.fieldTitle;
            document.getElementById('footer-text').innerText = tr.footer;
            document.getElementById('lang-select-label').innerText = lang === 'ar' ? 'اللغة' : (lang === 'fr' ? 'Langue' : 'Language');

            renderCountries();
            renderGrades();
            if (selectedGradeIndex !== null) renderSubjects();
            if (!document.getElementById('view-foundation').classList.contains('hidden')) renderFoundation();
            if (!document.getElementById('view-field').classList.contains('hidden')) renderFields();
        }

        function renderCountries() {
            const container = document.getElementById('countries-container');
            const tr = t();
            container.innerHTML = '';

            Object.keys(countries).forEach((code) => {
                const isActive = code === selectedCountry;
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.id = `btn-${code}`;
                btn.className = `country-btn p-4 rounded-xl border-2 font-bold text-lg transition shadow-sm ${
                    isActive ? 'border-indigo-600 bg-indigo-50' : 'border-slate-200 bg-white hover:border-indigo-300'
                }`;
                btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                btn.onclick = () => selectCountry(code);
                btn.innerHTML = `${countries[code].emoji} <span>${tr.countryNames[code]}</span>`;
                container.appendChild(btn);
            });
        }

        function renderGrades() {
            const container = document.getElementById('grades-container');
            const tr = t();
            container.innerHTML = '';

            tr.grades.forEach((grade, index) => {
                const card = document.createElement('button');
                card.type = 'button';
                card.className = 'bg-white border border-slate-200 rounded-xl p-5 text-center shadow-sm hover:shadow-md hover:border-indigo-500 cursor-pointer transition flex flex-col justify-between items-center group';
                card.onclick = () => openGrade(index);
                card.innerHTML = `
                    <span class="text-3xl font-black text-indigo-600 group-hover:scale-110 transition mb-2" aria-hidden="true">${index + 1}</span>
                    <span class="font-bold text-slate-700 text-sm md:text-base">${grade}</span>
                    <span class="text-xs text-indigo-500 mt-3 group-hover:underline">${tr.viewSubjects}</span>
                `;
                container.appendChild(card);
            });
        }

        function renderSubjects() {
            const tr = t();
            const grade = tr.grades[selectedGradeIndex];
            document.getElementById('subjects-title').innerText = tr.subjectsTitleFor(grade);

            // Grades 11-12 (index 10-11) use the senior subject set; rest use core.
            const isSenior = selectedGradeIndex >= 10;
            const isGrade12 = selectedGradeIndex === 11;
            const setKey = isSenior ? 'senior' : 'core';
            const subjectKeys = countries[selectedCountry].subjects[setKey].slice();

            const container = document.getElementById('subjects-container');
            container.innerHTML = '';
            subjectKeys.forEach((key) => {
                const meta = subjectMeta[key];
                const card = document.createElement('div');
                card.className = 'bg-white border border-slate-200 rounded-xl p-4 text-center shadow-sm flex flex-col items-center gap-2';
                card.innerHTML = `
                    <span class="text-3xl" aria-hidden="true">${meta.icon}</span>
                    <span class="font-bold text-slate-700 text-sm md:text-base">${meta[currentLang]}</span>
                `;
                container.appendChild(card);
            });

            // "تأسيس المواد الوزارية" only for grade 12 (الثاني عشر): one card that opens a sub-list.
            if (isGrade12) {
                const meta = subjectMeta.foundation;
                const card = document.createElement('button');
                card.type = 'button';
                card.onclick = () => openFoundation();
                card.className = 'bg-indigo-50 border-2 border-indigo-300 rounded-xl p-4 text-center shadow-sm hover:shadow-md hover:border-indigo-500 transition flex flex-col items-center gap-2 cursor-pointer';
                card.innerHTML = `
                    <span class="text-3xl" aria-hidden="true">${meta.icon}</span>
                    <span class="font-bold text-indigo-700 text-sm md:text-base">${meta[currentLang]}</span>
                `;
                container.appendChild(card);
            }
        }

        function renderFoundation() {
            const foundationKeys = ['foundationArabic', 'foundationIslamic', 'foundationHistory', 'foundationMath'];
            const container = document.getElementById('foundation-container');
            container.innerHTML = '';
            foundationKeys.forEach((key) => {
                const meta = subjectMeta[key];
                const card = document.createElement('div');
                card.className = 'bg-white border border-slate-200 rounded-xl p-4 text-center shadow-sm flex flex-col items-center gap-2';
                card.innerHTML = `
                    <span class="text-3xl" aria-hidden="true">${meta.icon}</span>
                    <span class="font-bold text-slate-700 text-sm md:text-base">${meta[currentLang]}</span>
                    <span class="text-xs text-indigo-600 flex items-center gap-1">👤 ${meta.teacher}</span>
                `;
                container.appendChild(card);
            });
        }
        // ---------- Navigation / state changes ----------
        function selectCountry(code) {
            selectedCountry = code;
            renderCountries();
            if (selectedGradeIndex !== null) renderSubjects();
        }

        function hideAllViews() {
            ['view-country', 'view-grades', 'view-field', 'view-subjects', 'view-foundation'].forEach((id) => {
                document.getElementById(id).classList.add('hidden');
            });
        }

        function renderFields() {
            const tr = t();
            const container = document.getElementById('fields-container');
            container.innerHTML = '';

            const academicBtn = document.createElement('button');
            academicBtn.type = 'button';
            academicBtn.onclick = () => selectField('academic');
            academicBtn.className = 'bg-white border-2 border-indigo-600 bg-indigo-50 rounded-xl p-6 text-center shadow-sm hover:shadow-md transition flex flex-col items-center gap-2 cursor-pointer';
            academicBtn.innerHTML = `
                <span class="text-3xl" aria-hidden="true">🎓</span>
                <span class="font-bold text-indigo-700 text-base">${tr.fieldAcademic}</span>
            `;
            container.appendChild(academicBtn);

            const bitcBtn = document.createElement('div');
            bitcBtn.className = 'bg-slate-100 border-2 border-slate-200 ro
                
